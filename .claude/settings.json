{
  "enabledPlugins": {
    "superpowers@anthropic-plugin-directory": true,
    "claude-md-management@anthropic-plugin-directory": true
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/prompt-gate.ps1\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/tool-tests.ps1\"",
            "timeout": 120,
            "statusMessage": "Tool testleri koşuyor..."
          }
        ]
      }
    ]
  }
}
