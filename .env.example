# .env.example — bu dosyayı .env olarak kopyalayıp değerleri doldurun.
# .env commit edilmez; bu şablon edilir.

# ───────── Anthropic / Claude ─────────
ANTHROPIC_API_KEY=             # zorunlu; gerçek değer sadece .env'de
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_TEMP_MODEL=          # geçici olarak denenecek ikinci model; boş = kapalı (ör. claude-sonnet-5-5)
# ANTHROPIC_MAX_TOKENS=16000
# ANTHROPIC_EFFORT=medium        # low | medium | high | xhigh | max

# ───────── Saat (backend/clock.py) ─────────
# Doluysa uygulama saati bu sabit andır (saat dilimi zorunlu); boş = sistem saati.
COPILOT_NOW=                   # ör. 2026-10-20T16:22:00+03:00

# ───────── Tool verisi (backend/tools) ─────────
# Tool'ların okuduğu gün verisi; her çağrıda yeniden okunur. Göreli yol repo köküne göredir.
# synth.generator ya da synth.corruption çıktısı da verilebilir; boş = tool'lar veri hatası döner.
COPILOT_DATA=data/referans/seed42-2026-10-20.json

# ───────── System talimatı (backend/instructions) ─────────
# Modele giden talimatın sürümü: v1 → backend/instructions/v1.md; boş = v1.
# Agent ve /chat kullanır; pytest'te --instruction verilmezse testler de bunu alır.
COPILOT_INSTRUCTION=v1

# ───────── Canlı konum akışı (docs/canli_akis.md) ─────────
# Doluysa backend açılışta broker'a abone olur, GET /live/positions çalışır; boş = tüketici kapalı.
# Backend konteynerde çalışıyorsa: mqtt://host.docker.internal:1883
COPILOT_MQTT_URL=mqtt://127.0.0.1:1883
COPILOT_MQTT_ROOT=aocc/sim/v1   # topic kökü; gerçek besleme aocc/live/v1

# ───────── PostgreSQL (docker compose) ─────────
POSTGRES_PASSWORD=
