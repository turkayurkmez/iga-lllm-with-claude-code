# .env.example — bu dosyayı .env olarak kopyalayıp değerleri doldurun.
# .env commit edilmez; bu şablon edilir.

# ───────── Anthropic / Claude ─────────
ANTHROPIC_API_KEY=             # zorunlu; gerçek değer sadece .env'de
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_TEMP_MODEL=          # geçici olarak denenecek ikinci model; boş = kapalı (ör. claude-sonnet-5-5)
# ANTHROPIC_MAX_TOKENS=16000
# ANTHROPIC_EFFORT=medium        # low | medium | high | xhigh | max

# ───────── PostgreSQL (docker compose) ─────────
POSTGRES_PASSWORD=
